{
  "name": "mistakes-party",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node tests/run-production-tests.mjs",
    "test:e2e": "playwright test",
    "test:security": "playwright test tests/security.spec.ts",
    "test:unit": "node --test tests/content-data.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern '.next-playwright-*'",
    "smoke:production": "node tests/run-production-tests.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
